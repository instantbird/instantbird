# This file records the make variables to be set by configure
CC := @CC@
CXX := @CXX@
CPP := @CPP@
CXXCPP := @CXXCPP@
LD := @LD@
CPPFLAGS := $(CPPFLAGS) @CPPFLAGS@
OUTPUT_OPTION = @OUTPUT_OPTION@

GTK_PREFIX := @GTK_PREFIX@

PIDGIN_SRC_PREFIX := @PIDGIN_SRC_PREFIX@
LIBPURPLE_PATH := @LIBPURPLE_PATH@

GECKO_PREFIX := @GECKO_PREFIX@
GECKO_INCLUDE := $(GECKO_PREFIX)/include
GECKO_LIBS := $(GECKO_PREFIX)/lib
GECKO_BINS := $(GECKO_PREFIX)/bin
MOZ_BINS := $(GECKO_PREFIX)/bin

XPIDL := @XPIDL@
XPTLINK := @XPTLINK@
XPIDLINCLUDES := $(GECKO_PREFIX)/idl

GNU_CC := @GNU_CC@
OS_TARGET := @OS_TARGET@

CONFIGJUNK := \
    config/config.mak \
    config.cache \
    config.log \
    config.status \
    $(NULL)

include config/@CONFIG_TARGET@/@CONFIG_TARGET@.mak
