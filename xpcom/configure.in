# initialize autoconf
AC_PREREQ(2.13)
AC_INIT(src/purpleModule.cpp)
AC_CONFIG_AUX_DIR(config)
AC_CANONICAL_SYSTEM

# convience macro: set (first arg) to (second arg) iff it doesn't already exist
AC_DEFUN([AC_SETIF], [if test -z "$$1" ; then $1="$2" ; fi])

# for win32 targets, default to using MSVC
case ${target} in
    *msvc|*cygwin|*mingw*)
        AC_SETIF([CC],[cl])
        # for C++, we need to set -TP to force C++,
        # and -nologo to pass the C++ preprocessor check
        AC_SETIF([CXX],[cl -TP -nologo])
        AC_SETIF([LD],[link])
        AC_SETIF([AS],[ml])
        ;;
    *)
        AC_SETIF([LD],[ld])
        AC_SETIF([AS],[as])
        ;;
esac

AC_PROG_CC([$CC gcc cc])
if test "yes" == "$GCC" ; then
    GNU_CC=1
fi
AC_PROG_CPP
AC_PROG_CXX([$CXX g++ c++ cxx])
if test "yes" == "$GCC" ; then
    GNU_CXX=1
fi
AC_PROG_CXXCPP
AC_EXEEXT

OUTPUT_OPTION="-o \$@"
case "${target}" in
    *msvc|*cygwin|*mingw*)
        if test -z "$GNU_CC" ; then
            # MSVC
            CPPFLAGS="${CPPFLAGS} -nologo -MD"
            OUTPUT_OPTION="-Fo\$@"
        fi
        OS_TARGET=WINNT
        ;;
    *)
        # for now assume everything else is close enough to linux
        OS_TARGET=Linux
        ;;
esac


### find GTK

AC_ARG_WITH(
    [gtk],
    [  --with-gtk=DIR          GTK prefix],
    [GTK_PREFIX=$withval])

# give a default GTK prefix if not specified
AC_SETIF([GTK_PREFIX], [/usr])

CPPFLAGS="${CPPFLAGS} -I${GTK_PREFIX}/lib/glib-2.0/include -I${GTK_PREFIX}/lib/gtk-2.0/include"
CPPFLAGS="${CPPFLAGS} -I${GTK_PREFIX}/include/glib-2.0"

AC_MSG_CHECKING([glib.h])
AC_TRY_COMPILE(
    [#include <glib.h>],
    [return (int)glib_check_version(GLIB_MAJOR_VERSION, GLIB_MINOR_VERSION, GLIB_MICRO_VERSION);],
    [AC_MSG_RESULT([$GTK_PREFIX/include/glib-2.0/glib.h])],
    [AC_MSG_ERROR([Cannot find $GTK_PREFIX/include/glib-2.0/glib.h])])

### find pidgin src
AC_ARG_WITH(
    [pidgin-src],
    [  --with-pidgin-src=DIR   pidgin source code prefix],
    [PIDGIN_SRC_PREFIX=$withval])

AC_SETIF([PIDGIN_SRC_PREFIX], [../libpurple/pidgin-2.0.2])


CPPFLAGS="${CPPFLAGS} -I${PIDGIN_SRC_PREFIX}"

AC_MSG_CHECKING([libpurple headers])
AC_TRY_COMPILE(
    [#include <glib.h>
    #include <libpurple/core.h>],
    [purple_core_init(0);],
    [AC_MSG_RESULT([found])],
    [AC_MSG_ERROR([Cannot find libpurple headers])])

### find libpurple
AC_ARG_WITH(
    [libpurple],
    [  --with-libpurple=DIR    libpurple prefix],
    [LIBPURPLE_PATH=$withval])

##AC_MSG_CHECKING([libpurple.so.1])

AC_SETIF([LIBPURPLE_PATH], [../libpurple/_inst/lib])

AC_CHECK_FILE([$LIBPURPLE_PATH/libpurple.so.0], ,
        [AC_MSG_ERROR([libpurple.so.1 not found])])

### find Gecko SDK
AC_ARG_WITH(
    [gecko],
    [  --with-gecko=DIR        path to gecko SDK],
    [GECKO_PREFIX=$withval])

AC_SETIF([GECKO_PREFIX], [../gecko-sdk])

CPPFLAGS="${CPPFLAGS} -I${GECKO_PREFIX}/include"

AC_MSG_CHECKING([Gecko SDK])
AC_LANG_SAVE
AC_LANG_CPLUSPLUS
AC_TRY_COMPILE(
    [#include <nsXPCOM.h>],
    [NS_InitXPCOM2(0,0,0);],
    [AC_MSG_RESULT([found])],
    [AC_MSG_ERROR([Cannot find Gecko SDK])])
AC_LANG_RESTORE

AC_PATH_PROG([XPIDL], [xpidl], [:],
    [$PATH:${GECKO_PREFIX}/bin])

AC_PATH_PROG([XPTLINK], [xpt_link], [:],
    [$PATH:${GECKO_PREFIX}/bin])

CPPFLAGS="${CPPFLAGS} -g"


### output
AC_SUBST([OS_TARGET])
AC_SUBST([GNU_CC])
AC_SUBST([CPP])
AC_SUBST([CXXCPP])
AC_SUBST([LD])
AC_SUBST([LIB_PREFIX])
AC_SUBST([LIB_SUFFIX])
AC_SUBST([DLL_PREFIX])
AC_SUBST([DLL_SUFFIX])
AC_SUBST([GTK_PREFIX])
AC_SUBST([PIDGIN_SRC_PREFIX])
AC_SUBST([LIBPURPLE_PATH])
AC_SUBST([GECKO_PREFIX])
AC_SUBST([OUTPUT_OPTION])
AC_OUTPUT([
    config/config.mak
    ])
